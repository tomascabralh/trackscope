# The breakdown runs on a local Ollama model. The defaults below work out
# of the box if Ollama is running on the standard port with llama3.2:3b pulled,
# so this file is optional — set these only to override.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# Hosted demo mode: refuses /api/breakdown and swaps the production-notes UI
# for a "run it locally" notice. Set on the public deploy, leave unset locally.
# NEXT_PUBLIC_DEMO_MODE=1
